# Copy to the project root as .env for Docker Compose.
# Bootstrap through an SSH tunnel first. Change to HTTPS before enabling Nginx.
APP_ORIGIN=http://127.0.0.1:4310
COOKIE_SECURE=false
DATABASE_PATH=/app/data/lab-planning.sqlite
DATA_VOLUME_NAME=lab-planning-data
# Set the exact trusted proxy IP/CIDR after checking the deployment network.
TRUST_PROXY=false

# After administrator setup and HTTPS configuration:
# APP_ORIGIN=https://planning.example.com
# COOKIE_SECURE=true
# TRUST_PROXY=172.18.0.1/32  # example only; use the actual Docker gateway IP

# Optional; configuration alone never sends report data.
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=

# Optional enterprise internal DingTalk H5 app. Complete HTTPS and identity testing first.
# See docs/dingtalk-public-server.md; CLIENT_ID is Client ID / AppKey, not AgentId.
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_APPLINK_ENABLED=false
# Leave false until the new server is verified. Administrator pilot approval is also required.
DINGTALK_NOTIFICATIONS_ENABLED=false
# summary: show authorized work details; minimal: private entry only. No history replay.
DINGTALK_NOTIFICATION_CONTENT_MODE=summary
# Fresh UUID for this new server/clone/database restore. Keep stable for ordinary restarts/upgrades.
# A copied database must never reuse the source deployment ID; re-enable the pilot explicitly.
DINGTALK_DEPLOYMENT_ID=

# Native capabilities remain off until HTTPS, permissions, template and device acceptance.
# Each channel also requires explicit verified settings and pilot members inside the app.
# Uses the CLIENT_ID/CLIENT_SECRET above. Keep real secrets only in this server env file.
DINGTALK_NATIVE_ENABLED=false
DINGTALK_NATIVE_STREAM_ENABLED=false
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_CODE=
# Optional verified developer-organization scope; blank uses CORP_ID.
DINGTALK_DEVELOPER_SCOPE=
DINGTALK_LEAVE_SYNC_INTERVAL_HOURS=24
DINGTALK_LEAVE_SYNC_LOOKBACK_DAYS=1
DINGTALK_LEAVE_SYNC_PAGE_LIMIT=20
# Template/permission/acceptance contract: docs/validation-2026-09-20-dingtalk-native.md

# The backup process needs a separate environment/key file; never put the key in this database volume.
VERIFIED_BACKUP_DIR=
BACKUP_KEY_FILE=
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_TOKEN=
