# Copy to /home/yzq/apps/lab-planning/.env.intranet on server 192.168.0.37.
# From that deployment root, use:
# docker compose --env-file .env.intranet -f current/compose.intranet.yaml ...
INTRANET_IP=192.168.0.37
INTRANET_PORT=4310
DATA_VOLUME_NAME=lab-planning-37-data

# APP_ORIGIN is computed from INTRANET_IP and INTRANET_PORT by Compose.
# Default: APP_ORIGIN=http://192.168.0.37:4310
# COOKIE_SECURE=false and TRUST_PROXY=false are fixed in this HTTP-only file.
# SQLite is stored at /app/data/lab-planning.sqlite inside the named volume.

# Optional; configuration alone never sends report data.
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=
