# Host Nginx, one trusted proxy, application exposed only on 127.0.0.1:4310.
# Replace planning.example.com and certificate paths before loading this file.
server {
    listen 80;
    server_name planning.example.com;
    return 301 https://planning.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name planning.example.com;
    ssl_certificate /etc/letsencrypt/live/planning.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/planning.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    # Node owns Accept-Encoding negotiation and Vary (gzip/deflate/Brotli), including
    # direct requests. Keep its Content-Encoding, validators and Cache-Control intact.
    # Only Vite manifest assets are immutable; HTML revalidates; all API data is no-store.
    gzip off;
    proxy_cache off;

    # Complete JSON restore packets may contain Word assets (32 MiB plus envelope).
    location ~* ^/api/data/restore/(?:preview|commit)/?$ {
        client_max_body_size 35m;
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    # One <=12 MiB DOCX, base64 encoded; application authenticates a manager first.
    location ~* ^/api/report-agent/assets/?$ {
        client_max_body_size 18m;
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    # Structured Word-table editing can include many cells and their fact references.
    location ~* ^/api/report-agent/(?:reports|templates)/[^/]+/?$ {
        client_max_body_size 4m;
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    # Feedback screenshots: at most three 2 MiB images encoded in a 9 MiB JSON body.
    location ~* ^/api/feedback(?:/[^/]+/actions)?/?$ {
        client_max_body_size 9m;
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite untrusted inbound forwarding headers at this sole edge proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
