# Local development defaults. Copy to .env; never commit real credentials.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/lab-planning.sqlite
NODE_ENV=development
# Set the public HTTPS origin and secure cookies behind your reverse proxy.
# APP_ORIGIN=https://planning.example.com
COOKIE_SECURE=false
# Optional exact trusted proxy IPs/CIDRs, comma-separated; default trusts none.
# TRUST_PROXY=loopback
# Docker production setup: see deploy/production.env.example and docs/deployment.md.

# Optional defaults for AI import and report polish. Managers can configure these in 数据导入 > AI 模型设置.
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model
# AI_VISION_MODEL=your-vision-model
# AI_API_KEY=

# Optional enterprise internal H5 app. See docs/dingtalk-public-server.md.
# CLIENT_ID is the app's Client ID / AppKey, not its AgentId.
# Keep credentials on the server; never put them in VITE_* variables.
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=
# Validated official H5 AppLink. Enable only after Android/iOS/desktop acceptance.
DINGTALK_APPLINK_ENABLED=false
# External sending requires HTTPS, this switch AND explicit administrator pilot settings.
DINGTALK_NOTIFICATIONS_ENABLED=false
# summary: show authorized work details; minimal: private entry only. No history replay.
DINGTALK_NOTIFICATION_CONTENT_MODE=summary
# Generate a fresh UUID for each new server/clone/database restore; keep stable on normal restarts.
# After changing this ID, an administrator must explicitly re-enable the pilot; old events are not replayed.
DINGTALK_DEPLOYMENT_ID=

# Optional native todo/cards/robot/org events. Code and mock tests do not enable a tenant.
# Also requires verified administrator capability settings and named pilot members.
# Reuses the server-only CLIENT_ID/CLIENT_SECRET above; do not add VITE_* secrets.
DINGTALK_NATIVE_ENABLED=false
DINGTALK_NATIVE_STREAM_ENABLED=false
# Real published template and robot IDs from this app; leave blank until provisioned.
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_CODE=
# Optional verified developer-organization scope for unionId; defaults to CORP_ID.
DINGTALK_DEVELOPER_SCOPE=
# Leave-record compensation: interval 1..168 hours, overlap 1..7 days, pages/run 1..100.
DINGTALK_LEAVE_SYNC_INTERVAL_HOURS=24
DINGTALK_LEAVE_SYNC_LOOKBACK_DAYS=1
DINGTALK_LEAVE_SYNC_PAGE_LIMIT=20
# Setup, template contract and tenant acceptance: docs/validation-2026-09-20-dingtalk-native.md

# Optional verified backups; key must be outside both database and backup directory trees.
VERIFIED_BACKUP_DIR=
BACKUP_KEY_FILE=
# Explicit upload command only. Fixed HTTPS directory supporting PUT + authenticated GET.
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_TOKEN=
